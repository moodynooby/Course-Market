{
  "name": "auraishub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "netlify dev",
    "build": "tsc -b && vite build && echo '/*  /index.html  200' > dist/_redirects",
    "build:native": "pnpm run build",
    "cap:sync": "pnpm run build:native && npx cap sync",
    "cap:build:android": "pnpm run build:native && npx cap sync android && npx cap open android",
    "cap:build:ios": "pnpm run build:native && npx cap sync ios && npx cap open ios",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "biome check --write .",
    "lint:staged": "biome check --write --staged --no-errors-on-unmatched",
    "test": "vitest run",
    "test:fast": "vitest run --exclude '**/*.slow.test.ts'",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "pre-commit": "pnpm run lint:staged && pnpm run typecheck && pnpm run test:fast",
    "setup:hooks": "lefthook install",
    "db:generate": "netlify dev:exec drizzle-kit generate",
    "db:push": "netlify dev:exec drizzle-kit push",
    "db:check": "netlify dev:exec drizzle-kit check",
    "db:studio": "netlify dev:exec drizzle-kit studio",
    "db:seed": "netlify dev:exec tsx db/seed.ts"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.24.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@netlify/neon": "^0.1.2",
    "@netlify/vite-plugin": "^2.12.9",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "html2canvas": "^1.4.1",
    "jose": "^6.2.8",
    "minisearch": "^7.2.0",
    "react": "^19.2.8",
    "react-big-calendar": "^1.20.0",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "react-virtuoso": "^4.18.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capawesome/capacitor-badge": "^8.0.2",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.10",
    "happy-dom": "^20.11.2",
    "lefthook": "^2.1.10",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
